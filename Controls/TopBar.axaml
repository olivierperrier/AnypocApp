<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:AnypocApp.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="60"
             x:Class="AnypocApp.Controls.TopBar"
             x:DataType="controls:TopBar"
             x:Name="Root">

    <Border Background="#2196F3" Height="60">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
            <!-- Burger Menu Button -->
            <Button Grid.Column="0"
                    x:Name="BurgerMenuButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <Border Width="24" Height="3" Background="White" CornerRadius="1.5"/>
                    <Border Width="24" Height="3" Background="White" CornerRadius="1.5"/>
                    <Border Width="24" Height="3" Background="White" CornerRadius="1.5"/>
                </StackPanel>
            </Button>

            <!-- Center Content: Either Search Box or Title -->
            <ContentControl Grid.Column="1"
                          Content="{Binding #Root.CenterContent}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          HorizontalContentAlignment="Stretch"
                          MaxWidth="500">
                <!-- Default Title if no CenterContent is provided -->
                <TextBlock Text="{Binding #Root.Title}"
                          Foreground="White"
                          FontSize="20"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>
            </ContentControl>

            <!-- Optional Right Actions -->
            <StackPanel Grid.Column="2"
                       Orientation="Horizontal"
                       Spacing="8"
                       VerticalAlignment="Center">
                <!-- Notification Icon -->
                <Button Background="Transparent"
                       BorderThickness="0"
                       Padding="8"
                       Cursor="Hand"
                       IsVisible="False">
                    <TextBlock Text="🔔" FontSize="20"/>
                </Button>

                <!-- Settings Icon -->
                <Button Background="Transparent"
                       BorderThickness="0"
                       Padding="8"
                       Cursor="Hand"
                       IsVisible="False">
                    <TextBlock Text="⚙️" FontSize="20"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

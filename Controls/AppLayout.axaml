<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:AnypocApp.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AnypocApp.Controls.AppLayout"
             x:DataType="controls:AppLayout"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- System Bar (top status bar) -->
        <controls:SystemBar Grid.Row="0"
                           IsWifiConnected="{Binding #Root.IsWifiConnected}"
                           IsEthernetConnected="{Binding #Root.IsEthernetConnected}"
                           WifiSignalStrength="{Binding #Root.WifiSignalStrength}"/>

        <!-- Top Bar (navigation bar) -->
        <controls:TopBar Grid.Row="1"
                        x:Name="TopBar"
                        Title="{Binding #Root.PageTitle}"
                        CenterContent="{Binding #Root.TopBarCenterContent}"/>

        <!-- Main Content Area -->
        <Border Grid.Row="2" Background="White">
            <ContentControl x:Name="ContentArea"
                          Content="{Binding #Root.PageContent}"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"/>
        </Border>

        <!-- Bottom Bar (info bar) -->
        <controls:BottomBar Grid.Row="3"
                           LeftInfo="{Binding #Root.BottomLeftInfo}"
                           CenterInfo="{Binding #Root.BottomCenterInfo}"
                           RightInfo="{Binding #Root.BottomRightInfo}"/>
    </Grid>
</UserControl>
